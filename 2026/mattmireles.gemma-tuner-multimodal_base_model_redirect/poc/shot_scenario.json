    { "command": "Select-String -Path work\\adapter_*\\adapter_config.json -Pattern base_model_name_or_path" },
    { "shot": "04-adapter-config-diff.png" },

    { "command": "Get-Content gemma-tuner-multimodal-ebdcd76d\\gemma_tuner\\scripts\\export.py | Select-Object -Skip 75 -First 21" },
    { "shot": "05-export-py-vulnerable.png" },

    { "command": "Get-Content gemma-tuner-multimodal-ebdcd76d\\gemma_tuner\\models\\gemma\\base_model_loader.py | Select-Object -Skip 102 -First 13" },
    { "shot": "06-base-model-loader.png" },

    { "command": "python run_repro.py adapter_attack" },
    { "wait": 45000 },
