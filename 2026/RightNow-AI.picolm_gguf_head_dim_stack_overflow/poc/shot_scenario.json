{
  "shell": "powershell",
  "workingDir": "%TEMP%",
  "initCommands": ["cd", "wsl -d kali-linux -- bash --norc --noprofile -i"],
  "windowWidth": 1400,
  "windowHeight": 800,
  "settleMs": 1000,
  "steps": [
    { "command": "cd /tmp/picolm-poc2/picolm-cf3f2df" },
    { "command": "export PS1='$ '" },
    { "command": "printf '\\033]2;picolm-poc2\\007'" },
    { "keys": "^-" },
    { "keys": "^-" },
    { "command": "gcc --version" },
    { "command": "python3 --version" },
    { "command": "python3 -m pip show gguf" },
    { "shot": "01-env.png" },
    { "command": "python3 make_poc2.py" },
    { "wait": 3000 },
    { "shot": "02-make-poc.png" },
    { "command": "sha256sum benign_heads2.gguf evil_heads1.gguf" },
    { "wait": 1000 },
    { "shot": "03-sha256.png" },
    { "command": "clear" },
    { "command": "~/.local/bin/gguf-dump benign_heads2.gguf --no-tensors" },
    { "command": "~/.local/bin/gguf-dump evil_heads1.gguf --no-tensors" },
    { "wait": 1500 },
    { "shot": "04-gguf-dump.png" },
    { "command": "cd picolm" },
    { "command": "make clean" },
    { "command": "make native" },
    { "wait": 5000 },
    { "command": "gcc -O0 -g -std=c11 -D_GNU_SOURCE -fsanitize=address -fno-omit-frame-pointer -o picolm-asan picolm.c model.c tensor.c quant.c tokenizer.c sampler.c grammar.c -lm -lpthread" },
    { "wait": 6000 },
    { "command": "ls -la picolm picolm-asan" },
    { "shot": "05-build.png" },
    { "command": "cd .." },
    { "command": "clear" },
    { "command": "./picolm/picolm benign_heads2.gguf -p \"hello\" -n 6 -j 2" },
    { "wait": 3000 },
    { "command": "echo $?" },
    { "wait": 2000 },
    { "shot": "06-benign-run.png" },
    { "command": "clear" },
    { "command": "ASAN_OPTIONS=detect_leaks=0:print_legend=0 ./picolm/picolm-asan benign_heads2.gguf -p \"hello\" -n 6 -j 2" },
    { "wait": 4000 },
    { "command": "echo $?" },
    { "wait": 2000 },
    { "shot": "07-benign-asan.png" },
    { "command": "clear" },
    { "command": "./picolm/picolm evil_heads1.gguf -p \"hello\" -n 6 -j 2" },
    { "wait": 3000 },
    { "command": "echo $?" },
    { "wait": 2000 },
    { "shot": "08-evil-native.png" },
    { "command": "clear" },
    { "command": "ASAN_OPTIONS=detect_leaks=0:print_legend=0 ./picolm/picolm-asan evil_heads1.gguf -p \"hello\" -n 6 -j 2" },
    { "wait": 5000 },
    { "command": "echo $?" },
    { "wait": 2500 },
    { "shot": "09-evil-asan.png" },
    { "command": "ASAN_OPTIONS=detect_leaks=0:print_legend=0 ./picolm/picolm-asan evil_heads1.gguf -p \"hello\" -n 6 -j 2 2> asan-crash.log" },
    { "wait": 5000 },
    { "command": "clear" },
    { "command": "head -21 asan-crash.log" },
    { "wait": 1200 },
    { "shot": "10-asan-report-head.png" },
    { "command": "exit" }
  ]
}
