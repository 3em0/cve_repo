{
  "shell": "powershell",
  "workingDir": "%TEMP%\\poc-work",
  "windowWidth": 1400,
  "windowHeight": 900,
  "settleMs": 1200,
  "initCommands": ["wsl -d kali-linux"],
  "steps": [
    { "command": "cd ~/poc-work" },
    { "command": "ls" },
    { "shot": "01-workdir.png" },
    { "command": "cat whisper.cpp-5670d5c0/COMMIT.txt" },
    { "shot": "02-commit.png" },
    { "command": "python3 make_poc.py whisper.cpp-5670d5c0" },
    { "wait": 1500 },
    { "shot": "03-make-poc.png" },
    { "command": "sha256sum artifact/model_base.bin artifact/model_benign.bin artifact/model_evil.bin" },
    { "wait": 800 },
    { "shot": "04-sha256.png" },
    { "command": "cd whisper.cpp-5670d5c0" },
    { "command": "ls -la build/bin/whisper-cli" },
    { "wait": 500 },
    { "shot": "05-binary.png" },
    { "command": "setarch -R ./build/bin/whisper-cli -m ../artifact/model_evil.bin -f samples/jfk.wav -t 1" },
    { "wait": 4000 },
    { "shot": "06-evil-live.png" },
    { "command": "echo $?" },
    { "wait": 500 },
    { "shot": "07-evil-exit.png" },
    { "command": "setarch -R ./build/bin/whisper-cli -m ../artifact/model_evil.bin -f samples/jfk.wav -t 1 > /tmp/evil_full.txt 2>&1" },
    { "wait": 4000 },
    { "command": "sed -n '/ERROR: AddressSanitizer/,/SUMMARY: AddressSanitizer/p' /tmp/evil_full.txt" },
    { "wait": 800 },
    { "shot": "08-evil-asan-report.png" },
    { "command": "setarch -R ./build/bin/whisper-cli -m ../artifact/model_base.bin -f samples/jfk.wav -t 1" },
    { "wait": 55000 },
    { "shot": "09-base-control.png" },
    { "command": "echo $?" },
    { "wait": 500 },
    { "shot": "10-base-exit.png" },
    { "command": "ASAN_OPTIONS=detect_leaks=0 setarch -R ./build/bin/whisper-cli -m ../artifact/model_benign.bin -f samples/jfk.wav -t 1" },
    { "wait": 5000 },
    { "shot": "11-benign-control.png" },
    { "command": "echo $?" },
    { "wait": 500 },
    { "shot": "12-benign-exit.png" }
  ]
}
