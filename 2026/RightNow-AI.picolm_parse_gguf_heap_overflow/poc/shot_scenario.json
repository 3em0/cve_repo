{
  "shell": "powershell",
  "workingDir": "%TEMP%",
  "initCommands": ["cd", "wsl -d kali-linux -- bash --norc --noprofile -i"],
  "windowWidth": 1400,
  "windowHeight": 860,
  "settleMs": 1000,
  "steps": [
    { "command": "cd /tmp/picolm-poc/picolm-cf3f2df" },
    { "command": "export PS1='$ '" },
    { "command": "printf '\\033]2;picolm-poc\\007'" },
    { "keys": "^-" },
    { "keys": "^-" },
    { "keys": "^-" },
    { "command": "gcc --version" },
    { "command": "python3 --version" },
    { "shot": "01-env.png" },
    { "command": "python3 make_poc.py" },
    { "wait": 800 },
    { "shot": "02-make-poc.png" },
    { "command": "cat SHA256SUMS.txt" },
    { "shot": "03-sha256.png" },
    { "command": "cd picolm" },
    { "command": "make clean" },
    { "command": "make native" },
    { "wait": 4000 },
    { "command": "gcc -O0 -g -std=c11 -D_GNU_SOURCE -fsanitize=bounds -fno-omit-frame-pointer -o picolm-bounds picolm.c model.c tensor.c quant.c tokenizer.c sampler.c grammar.c -lm -lpthread" },
    { "wait": 5000 },
    { "command": "gcc -O0 -g -std=c11 -D_GNU_SOURCE -fsanitize=address -fno-omit-frame-pointer -o picolm-asan picolm.c model.c tensor.c quant.c tokenizer.c sampler.c grammar.c -lm -lpthread" },
    { "wait": 6000 },
    { "command": "ls -la picolm picolm-bounds picolm-asan" },
    { "shot": "04-build.png" },
    { "command": "cd .." },
    { "command": "clear" },
    { "command": "./picolm/picolm benign.gguf -p \"hello\" -n 4 -j 2" },
    { "wait": 1500 },
    { "shot": "05-benign-run.png" },
    { "command": "clear" },
    { "command": "./picolm/picolm-bounds benign.gguf -p \"hello\" -n 2 -j 2" },
    { "wait": 1500 },
    { "shot": "06-bounds-benign.png" },
    { "command": "clear" },
    { "command": "./picolm/picolm-bounds evil_dims5.gguf -p \"hello\" -n 2 -j 2" },
    { "wait": 1500 },
    { "command": "echo $?" },
    { "wait": 2500 },
    { "shot": "07-evil5-oob-write.png" },
    { "command": "clear" },
    { "command": "ASAN_OPTIONS=detect_leaks=0:print_legend=0 ./picolm/picolm-asan evil_dims9.gguf -p \"hello\" -n 2 -j 2" },
    { "wait": 3000 },
    { "command": "echo $?" },
    { "wait": 2500 },
    { "shot": "08-asan-heap-overflow.png" },
    { "command": "ASAN_OPTIONS=detect_leaks=0:print_legend=0 ./picolm/picolm-asan evil_dims9.gguf -p \"hello\" -n 2 -j 2 2> asan-crash.log" },
    { "wait": 3000 },
    { "command": "head -16 asan-crash.log" },
    { "wait": 1000 },
    { "shot": "09-asan-report-head.png" },
    { "command": "exit" }
  ]
}
