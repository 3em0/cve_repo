{
  "shell": "powershell",
  "windowTitle": "sf-cve-repro-1dc7f63",
  "workingDir": "%TEMP%",
  "windowWidth": 1400,
  "windowHeight": 900,
  "settleMs": 1400,
  "charDelayMs": 26,
  "initCommands": [
    "wsl -d kali-linux"
  ],
  "steps": [
    { "wait": 25000 },
    { "command": "cd ~/sf_repro/poc-work" },
    { "wait": 600 },
    { "command": "source ~/sf_repro/venv/bin/activate" },
    { "wait": 900 },
    { "command": "clear" },
    { "wait": 500 },
    { "command": "python --version" },
    { "wait": 700 },
    { "command": "python -c \"import torch, gymnasium, cv2, sample_factory; print('torch', torch.__version__); print('gymnasium', gymnasium.__version__); print('opencv', cv2.__version__); print('sample-factory', sample_factory.__file__)\"" },
    { "wait": 6000 },
    { "shot": "01-env-versions.png" },

    { "command": "clear" },
    { "wait": 500 },
    { "command": "ffmpeg -version" },
    { "wait": 1500 },
    { "scroll": "up", "times": 2 },
    { "wait": 700 },
    { "shot": "02-ffmpeg-version.png" },
    { "scroll": "down", "times": 3 },
    { "wait": 700 },

    { "command": "clear" },
    { "wait": 600 },
    { "command": "sed -n '13,19p' ~/sf_repro/sf-src/sample_factory/huggingface/huggingface_utils.py" },
    { "wait": 800 },
    { "command": "sed -n '36,40p' ~/sf_repro/sf-src/sample_factory/huggingface/huggingface_utils.py" },
    { "wait": 900 },
    { "shot": "03-sink-lines.png" },

    { "command": "sha256sum ~/sf_repro/sf-src/sample_factory/huggingface/huggingface_utils.py" },
    { "wait": 700 },
    { "command": "wc -l ~/sf_repro/sf-src/sample_factory/huggingface/huggingface_utils.py" },
    { "wait": 800 },
    { "shot": "04-sink-sha256.png" },

    { "command": "clear" },
    { "wait": 600 },
    { "command": "ls -l train_dir/cartpole_repro" },
    { "wait": 800 },
    { "command": "ls -l train_dir/cartpole_repro/checkpoint_p0" },
    { "wait": 800 },
    { "shot": "05-trainer-output.png" },

    { "command": "clear" },
    { "wait": 600 },
    { "command": "python make_poc.py" },
    { "wait": 4000 },
    { "shot": "06-make-poc.png" },

    { "command": "ls -l models/evil_train_dir/cartpole_repro" },
    { "wait": 800 },
    { "command": "ls -l models/evil_train_dir/cartpole_repro/checkpoint_p0" },
    { "wait": 800 },
    { "shot": "07-evil-package.png" },

    { "command": "diff models/evil_train_dir/cartpole_repro/config.json models/benign_train_dir/cartpole_repro/config.json" },
    { "wait": 1000 },
    { "shot": "08-config-diff.png" },

    { "command": "grep -n \"save_video\\|max_num_frames\\|video_name\" models/evil_train_dir/cartpole_repro/config.json" },
    { "wait": 1000 },
    { "shot": "09-evil-config-fields.png" },

    { "command": "clear" },
    { "wait": 600 },
    { "command": "export MARKER_PATH=/tmp/sf2_marker.txt" },
    { "wait": 500 },
    { "command": "rm -f /tmp/sf2_marker.txt" },
    { "wait": 500 },
    { "command": "rm -rf /tmp/sf2_galaxyn" },
    { "wait": 500 },
    { "command": "python -m sf_examples.enjoy_gym_env --env=CartPole-v1 --train_dir=models/evil_train_dir --experiment=cartpole_repro" },
    { "wait": 12000 },
    { "shot": "11-evil-run-end.png" },
    { "scroll": "top" },
    { "scroll": "linedown", "times": 12 },
    { "wait": 1200 },
    { "shot": "10-evil-run-start.png" },
    { "scroll": "down", "times": 8 },
    { "wait": 1500 },

    { "command": "cat /tmp/sf2_marker.txt" },
    { "wait": 800 },
    { "command": "ls -l /tmp/sf2_marker.txt" },
    { "wait": 800 },
    { "shot": "12-marker-landed.png" },

    { "command": "ls -l /tmp/sf2_galaxyn" },
    { "wait": 900 },
    { "shot": "13-unquoted-shell-string.png" },

    { "command": "clear" },
    { "wait": 600 },
    { "command": "rm -f /tmp/sf2_marker.txt" },
    { "wait": 500 },
    { "command": "rm -rf /tmp/sf2_galaxyn" },
    { "wait": 500 },
    { "command": "python -m sf_examples.enjoy_gym_env --env=CartPole-v1 --train_dir=models/benign_train_dir --experiment=cartpole_repro" },
    { "wait": 9000 },
    { "shot": "14-benign-run.png" },

    { "command": "ls -l /tmp/sf2_marker.txt" },
    { "wait": 800 },
    { "command": "ls -l models/benign_train_dir/cartpole_repro/clip.mp4" },
    { "wait": 800 },
    { "shot": "15-negative-control.png" }
  ]
}
