{
  "shell": "cmd",
  "windowWidth": 1400,
  "windowHeight": 680,
  "settleMs": 1500,
  "initCommands": ["cd /d \"%TEMP%\\poc-work\\argilla-5338519\""],
  "steps": [
    { "command": "python --version" },
    { "wait": 800 },
    { "shot": "01-env-python.png" },
    { "command": "docker run -d --name es-seq097 -p 9202:9200 -e discovery.type=single-node -e xpack.security.enabled=false -e \"ES_JAVA_OPTS=-Xms512m -Xmx512m\" docker.elastic.co/elasticsearch/elasticsearch:8.11.4" },
    { "wait": 15000 },
    { "shot": "02-es-container-started.png" },
    { "command": "curl -s http://localhost:9202" },
    { "wait": 15000 },
    { "command": "curl -s http://localhost:9202" },
    { "wait": 15000 },
    { "command": "curl -s http://localhost:9202" },
    { "wait": 8000 },
    { "shot": "03-es-healthy.png" },
    { "command": "python -m venv .venv" },
    { "wait": 10000 },
    { "command": ".venv\\Scripts\\activate" },
    { "wait": 1000 },
    { "command": "pip install argilla-server==2.8.0 -i https://pypi.tuna.tsinghua.edu.cn/simple" },
    { "wait": 60000 },
    { "wait": 60000 },
    { "wait": 60000 },
    { "wait": 60000 },
    { "shot": "04-pip-install-argilla-server.png" },
    { "command": "pip install \"click<8.2\" -i https://pypi.tuna.tsinghua.edu.cn/simple" },
    { "wait": 30000 },
    { "shot": "05-pip-click-pin.png" },
    { "command": "set ARGILLA_DATABASE_URL=sqlite+aiosqlite:///argilla.db" },
    { "wait": 800 },
