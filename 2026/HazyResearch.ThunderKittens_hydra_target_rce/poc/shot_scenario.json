{
  "shell": "powershell",
  "workingDir": "%TEMP%\\poc-work",
  "windowWidth": 1400,
  "windowHeight": 680,
  "settleMs": 1200,
  "initCommands": [
    "wsl -d kali-linux"
  ],
  "steps": [
    { "wait": 3000 },
    { "command": "cd ~/poc-work/tk-run" },
    { "wait": 500 },
    { "command": "ls" },
    { "wait": 500 },
    { "shot": "01-kali-env.png" },
    { "command": "docker run --rm -it -v ~/poc-work:/work -w /work tk-poc-env bash" },
    { "wait": 2500 },
    { "shot": "02-container-entry.png" },
    { "command": "cd /work/tk-run" },
    { "wait": 400 },
    { "command": "python --version" },
    { "wait": 900 },
    { "shot": "03-env-python.png" },
    { "command": "python -c \"import sys,torch,transformers,hydra,omegaconf,einops,triton; print('python', sys.version.split()[0]); print('torch', torch.__version__); print('transformers', transformers.__version__); print('hydra-core', hydra.__version__); print('omegaconf', omegaconf.__version__); print('einops', einops.__version__); print('triton', triton.__version__)\"" },
    { "wait": 9000 },
    { "shot": "04-versions.png" },
    { "command": "clear" },
    { "wait": 500 },
    { "command": "python make_poc.py" },
    { "wait": 1600 },
    { "shot": "05-make-poc.png" },
    { "command": "ls evil_model" },
    { "wait": 500 },
    { "shot": "06-evil-tree.png" },
    { "command": "cat evil_model/config.json" },
    { "wait": 600 },
    { "shot": "07-evil-config.png" },
    { "command": "diff evil_model/config.json benign_model/config.json" },
    { "wait": 600 },
    { "shot": "08-config-diff.png" },
    { "command": "clear" },
    { "wait": 500 },
    { "command": "python run_load.py evil_model" },
    { "wait": 13000 },
    { "shot": "09-evil-load.png" },
    { "command": "ls" },
    { "wait": 500 },
    { "shot": "10-canary-landed.png" },
    { "command": "rm tk_hydra_canary.txt" },
    { "wait": 400 },
    { "command": "clear" },
    { "wait": 400 },
    { "command": "python run_load.py benign_model" },
    { "wait": 13000 },
    { "shot": "11-benign-load.png" },
    { "command": "ls" },
    { "wait": 500 },
    { "shot": "12-canary-absent.png" }
  ]
}
