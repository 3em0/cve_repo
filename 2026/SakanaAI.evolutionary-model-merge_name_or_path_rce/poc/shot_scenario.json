    { "command": "python check_marker.py" },
    { "shot": "12-control-no-marker.png" },

    { "command": "python victim_load.py work/attacker/model-A-evil" },
    { "wait": 20000 },
    { "shot": "13-attack-payload-runs.png" },

    { "command": "python check_marker.py" },
    { "shot": "14-marker-exists.png" },

    { "command": "python victim_config_only.py work/hub/model-A-hub" },
    { "wait": 20000 },
    { "shot": "15-hub-repo-id.png" },

    { "command": "rm -f /tmp/sakana_nested_name_or_path_marker" },
    { "command": "python check_marker.py" },
    { "shot": "16-cleanup.png" },

    { "command": "exit" }
  ]
