    { "wait": 18000 },
    { "shot": "01-environment.png" },

    { "command": "python make_poc.py" },
    { "wait": 45000 },
    { "shot": "02-make-poc.png" },

    { "command": "Get-Content work\\adapter_attack\\adapter_config.json -TotalCount 6" },
