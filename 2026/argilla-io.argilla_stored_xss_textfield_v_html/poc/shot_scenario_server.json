    { "wait": 45000 },
    { "shot": "06-db-migrate.png" },
    { "command": "python -m argilla_server database users create --first-name Owner --username owner --password 12341234 --role owner --workspace seq097-ws" },
    { "wait": 30000 },
    { "shot": "07-create-owner-user.png" },
    { "command": "python -m argilla_server start --port 6910" },
    { "wait": 45000 },
    { "shot": "08-server-started.png" }
  ]
